# Cadena de conexión a PostgreSQL.
# Cambia "TU_PASSWORD" por la contraseña que pusiste al instalar PostgreSQL 17.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/web_ventas?schema=public"

# Clave secreta para firmar los tokens JWT (cámbiala por una cadena larga y aleatoria).
JWT_SECRET="cambia-esto-por-una-clave-larga-y-secreta"
JWT_EXPIRES_IN="12h"

# Puerto del servidor
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
CLIENT_ORIGIN="http://localhost:5173"
