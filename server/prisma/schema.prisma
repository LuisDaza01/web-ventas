// Esquema de base de datos - Sistema de Inventario y Punto de Venta
// Prisma + PostgreSQL
//
// MULTI-TENANT (SaaS): cada negocio es una `Tienda`. Todas las tablas de
// negocio llevan `tiendaId` y los datos se aíslan por tienda (ver
// server/src/config/db.js — extensión de Prisma que inyecta el filtro).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Plataforma / Tiendas (tenants) ----------
enum Plan {
  FREE
  BASIC
  PRO
}

model Tienda {
  id        Int      @id @default(autoincrement())
  nombre    String
  slug      String   @unique // identificador legible para URL / soporte
  plan      Plan     @default(FREE)
  activa    Boolean  @default(true) // si está suspendida, se bloquea el acceso

  // Personalización por tienda
  moneda        String  @default("BOB") // código ISO de la moneda
  simbolo       String  @default("Bs") // símbolo que se muestra en precios
  impuesto      Decimal @default(0) @db.Decimal(5, 2) // % de impuesto (ej. IVA)
  direccion     String? // dirección para el recibo
  telefono      String? // teléfono para el recibo
  mensajeRecibo String? // mensaje al pie del recibo
  logoUrl       String? // logo de la tienda
  qrPagoUrl     String? // imagen del QR de cobro (el cliente lo escanea para pagar)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories Category[]
  suppliers  Supplier[]
  products   Product[]
  sales      Sale[]
  purchases  Purchase[]
  movements  StockMovement[]
}

// ---------- Usuarios y roles ----------
enum Role {
  SUPERADMIN // Dueño de la plataforma: administra tiendas (sin tiendaId)
  ADMIN // Administrador de una tienda: ve y hace todo dentro de su tienda
  CAJERO // Cajero: solo vende
  ALMACEN // Encargado de almacén: registra productos y stock
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique // login global en toda la plataforma
  username  String? // opcional, nombre corto legible
  password  String // hash bcrypt
  role      Role     @default(CAJERO)
  active    Boolean  @default(true)
  tiendaId  Int? // null SOLO para SUPERADMIN
  tienda    Tienda?  @relation(fields: [tiendaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  purchases Purchase[]
  movements StockMovement[]

  @@index([tiendaId])
}

// ---------- Catálogo ----------
model Category {
  id        Int       @id @default(autoincrement())
  name      String
  tiendaId  Int
  tienda    Tienda    @relation(fields: [tiendaId], references: [id])
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([tiendaId, name]) // único por tienda, no global
  @@index([tiendaId])
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  tiendaId  Int
  tienda    Tienda     @relation(fields: [tiendaId], references: [id])
  createdAt DateTime   @default(now())
  products  Product[]
  purchases Purchase[]

  @@index([tiendaId])
}

model Product {
  id            Int       @id @default(autoincrement())
  barcode       String // código de barras (único POR TIENDA)
  name          String
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id])
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2) // precio de compra
  salePrice     Decimal   @default(0) @db.Decimal(12, 2) // precio de venta
  stock         Int       @default(0) // cantidad en stock
  minStock      Int       @default(5) // umbral de alerta de stock bajo
  expiryDate    DateTime? // fecha de vencimiento (opcional)
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  imageUrl      String? // imagen (opcional)
  active        Boolean   @default(true)
  tiendaId      Int
  tienda        Tienda    @relation(fields: [tiendaId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  @@unique([tiendaId, barcode]) // un mismo código puede existir en otra tienda
  @@index([name])
  @@index([categoryId])
  @@index([tiendaId])
}

// ---------- Ventas ----------
enum MetodoPago {
  EFECTIVO
  QR
}

model Sale {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  tiendaId   Int
  tienda     Tienda     @relation(fields: [tiendaId], references: [id])
  total      Decimal    @db.Decimal(12, 2)
  paid       Decimal    @db.Decimal(12, 2) // monto recibido
  change     Decimal    @db.Decimal(12, 2) // cambio / vuelto
  metodoPago MetodoPago @default(EFECTIVO)
  createdAt  DateTime   @default(now())
  items      SaleItem[]

  @@index([tiendaId])
  @@index([createdAt])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) // precio de venta al momento de la venta
  unitCost  Decimal @default(0) @db.Decimal(12, 2) // costo al momento (para ganancia)
  subtotal  Decimal @db.Decimal(12, 2)
}

// ---------- Compras / Entrada de stock ----------
model Purchase {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id])
  supplierId Int?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  tiendaId   Int
  tienda     Tienda         @relation(fields: [tiendaId], references: [id])
  note       String?
  total      Decimal        @default(0) @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  items      PurchaseItem[]

  @@index([tiendaId])
  @@index([createdAt])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
}

// ---------- Historial de movimientos de stock ----------
enum MovementType {
  SALE // salida por venta
  PURCHASE // entrada por compra
  ADJUSTMENT // ajuste manual
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  productId   Int
  product     Product      @relation(fields: [productId], references: [id])
  tiendaId    Int
  tienda      Tienda       @relation(fields: [tiendaId], references: [id])
  type        MovementType
  quantity    Int // positivo = entrada, negativo = salida
  stockAfter  Int // stock resultante tras el movimiento
  referenceId Int? // id de la venta o compra relacionada
  note        String?
  userId      Int?
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([tiendaId])
  @@index([productId])
  @@index([createdAt])
}
