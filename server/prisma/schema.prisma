// Esquema de base de datos - Sistema de Inventario y Punto de Venta
// Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y roles ----------
enum Role {
  ADMIN // Administrador: ve y hace todo
  CAJERO // Cajero: solo vende
  ALMACEN // Encargado de almacén: registra productos y stock
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String // hash bcrypt
  role      Role     @default(CAJERO)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales         Sale[]
  purchases     Purchase[]
  movements     StockMovement[]
}

// ---------- Catálogo ----------
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime   @default(now())
  products  Product[]
  purchases Purchase[]
}

model Product {
  id            Int       @id @default(autoincrement())
  barcode       String    @unique // código de barras
  name          String
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id])
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2) // precio de compra
  salePrice     Decimal   @default(0) @db.Decimal(12, 2) // precio de venta
  stock         Int       @default(0) // cantidad en stock
  minStock      Int       @default(5) // umbral de alerta de stock bajo
  expiryDate    DateTime? // fecha de vencimiento (opcional)
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  imageUrl      String? // imagen (opcional)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  @@index([name])
  @@index([categoryId])
}

// ---------- Ventas ----------
model Sale {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  total     Decimal    @db.Decimal(12, 2)
  paid      Decimal    @db.Decimal(12, 2) // monto recibido
  change    Decimal    @db.Decimal(12, 2) // cambio / vuelto
  createdAt DateTime   @default(now())
  items     SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) // precio de venta al momento de la venta
  unitCost  Decimal @default(0) @db.Decimal(12, 2) // costo al momento (para ganancia)
  subtotal  Decimal @db.Decimal(12, 2)
}

// ---------- Compras / Entrada de stock ----------
model Purchase {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id])
  supplierId Int?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  note       String?
  total      Decimal        @default(0) @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  items      PurchaseItem[]

  @@index([createdAt])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
}

// ---------- Historial de movimientos de stock ----------
enum MovementType {
  SALE // salida por venta
  PURCHASE // entrada por compra
  ADJUSTMENT // ajuste manual
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  productId   Int
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Int // positivo = entrada, negativo = salida
  stockAfter  Int // stock resultante tras el movimiento
  referenceId Int? // id de la venta o compra relacionada
  note        String?
  userId      Int?
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
}
